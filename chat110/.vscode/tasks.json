{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chat110: Inspect Token Scores",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--managed-python",
        "python",
        "-m",
        "decoders.stage_00_inspect"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "focus": true,
        "reveal": "always"
      }
    },
    {
      "label": "Chat110: Chat with a Completed Stage",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--managed-python",
        "chat110",
        "--stage",
        "${input:stage}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "focus": true,
        "reveal": "always"
      }
    },
    {
      "label": "Create Chat110 Submission",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--managed-python",
        "python",
        "scripts/export_chat110_exercise.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "focus": true,
        "reveal": "always"
      }
    }
  ],
  "inputs": [
    {
      "id": "stage",
      "type": "pickString",
      "description": "Choose a stage you have completed.",
      "options": [
        "1",
        "2",
        "3",
        "4"
      ],
      "default": "1"
    }
  ]
}
